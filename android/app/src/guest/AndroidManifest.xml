<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mathblitz.guest"
    android:versionCode="1"
    android:versionName="2.1.0">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />
    <application android:allowBackup="false" android:icon="@drawable/mathblitz_icon"
        android:label="@string/app_name" android:theme="@style/MathBlitzTheme"
        android:usesCleartextTraffic="false">
        <activity android:name=".GuestActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
