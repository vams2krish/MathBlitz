{
  "name": "mathblitz-desktop",
  "productName": "MathBlitz",
  "version": "2.1.0",
  "description": "MathBlitz everyday math practice",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "node ../scripts/stage_guest.mjs web && electron-builder --win nsis --x64",
    "smoke": "electron . --smoke-test"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.mathblitz.desktop",
    "artifactName": "MathBlitz-${version}-Windows-${arch}-Setup.${ext}",
    "directories": { "output": "../artifacts/windows" },
    "files": ["main.cjs", "web/**"],
    "afterPack": "./fuses.cjs",
    "win": { "icon": "../branding/mathblitz.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "installerIcon": "../branding/mathblitz.ico", "uninstallerIcon": "../branding/mathblitz.ico" }
  }
}
